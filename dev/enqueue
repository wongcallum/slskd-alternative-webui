#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command -v jq >/dev/null || exec nix develop "$root" -c "$0" "$@"

api="http://localhost:5030/api/v0"
last="$root/.dev/enqueue-last.json"

token=$(curl -sf "$api/session" -H 'Content-Type: application/json' -d '{"username":"slskd","password":"slskd"}' | jq -r .token)
call() {
  local body
  if ! body=$(curl -s --fail-with-body -H "Authorization: Bearer $token" -H 'Content-Type: application/json' "$@"); then
    echo "request failed: $body" >&2
    exit 1
  fi
  printf '%s' "$body"
}

search() {
  local id
  id=$(call "$api/searches" -d "$(jq -n --arg text "$*" '{searchText: $text}')" | jq -r .id)
  echo "searching for \"$*\"..." >&2
  until call "$api/searches/$id" | jq -e '.state | contains("Completed")' >/dev/null; do sleep 1; done
  mkdir -p "$(dirname "$last")"
  call "$api/searches/$id/responses" | jq --arg search "$id" '
    def folder: sub("[\\\\/][^\\\\/]*$"; "");
    [.[] | .username as $user | .files | group_by(.filename | folder)[]
      | {username: $user, directory: (.[0].filename | folder), files: map({filename, size})}]
    | {searchId: $search, folders: sort_by(-(.files | length))}' >"$last"
  jq -r 'if .folders == [] then "no results" else .folders | to_entries[] | "\(.key)\t\(.value.files | length) files\t\(.value.username)\t\(.value.directory)" end' "$last" |
    head -n 40
}

pick() {
  jq --argjson n "$1" '{searchId, username: .folders[$n].username, files: .folders[$n].files}' "$last" |
    call "$api/transfers/downloads/batches" -d @- |
    jq '{batch: .batch.id, username: .batch.username, enqueued: (.batch.transfers | length), failures}'
}

command=${1:-}
shift || true
case "$command" in
  search) search "$@" ;;
  pick) pick "$@" ;;
  *) echo "usage: dev/enqueue search <text...> | pick <n>" >&2; exit 1 ;;
esac
